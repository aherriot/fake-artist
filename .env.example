# Neon -- use the POOLED connection string (host contains "-pooler").
# The pooled endpoint is what lets many autoscaled function instances share
# a small number of real Postgres backends.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel region matching your Neon region, so functions sit next to the DB.
# iad1=us-east-1, cle1=us-east-2, sfo1=us-west-1, fra1=eu-central-1, syd1=ap-southeast-2
NEON_REGION="iad1"

# Random string; signs the player-identity cookie. `openssl rand -base64 32`
SESSION_SECRET=""

# Pusher Channels (free Sandbox plan: 100 connections, 200k msgs/day)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# Guards the cleanup cron. Vercel injects this automatically in production
# when set as a project env var. `openssl rand -base64 32`
CRON_SECRET=""
